# Set to true to auto-grant routing to any Meshnet peer that lacks it (self-heal),
# so newly-added devices can reach Docker-published services without manual steps.
# Default false = report-only: the check reports DOWN if any peer can't route.
# Security note: granting routing lets that peer route traffic through this host.
ALLOW_ALL_PEERS_ROUTING=false
KUMA_PUSH_URL=https://kuma.example/api/push/REPLACE_ME
